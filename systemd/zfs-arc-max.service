[Unit]
Description=Cap the ZFS ARC at 2 GiB (Strata P100 Q3 deployment: leaves RAM for the PLE table and resident experts)
ConditionPathExists=/sys/module/zfs/parameters/zfs_arc_max
After=zfs-load-module.service
Before=strata-q3.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 2 GiB (was 8 until 2026-10-18): the box runs only this service; the engine reads the model files once at start
# and then serves from VRAM and locked RAM, so a larger ARC held blocks nothing reread (the mmapped PLE table
# was cached twice, in the page cache and the ARC: openzfs#16031).  The ARC minimum is 1/32 of RAM (1.96 GiB).
# zfs_arc_shrinker_limit=0 (OpenZFS's newer default): the ARC gives memory back without a per-call cap when the
# kernel asks, so a sudden demand does not end in an OOM kill while the ARC is still large
ExecStart=/bin/sh -ec 'echo 2147483648 > /sys/module/zfs/parameters/zfs_arc_max; echo 0 > /sys/module/zfs/parameters/zfs_arc_shrinker_limit'
# No ExecStop: writing 0 at run time does not lift the cap on OpenZFS 2.2 (it would only show 0).  To undo:
# systemctl disable zfs-arc-max.service and reboot.

[Install]
WantedBy=multi-user.target
